#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "dev.alpallel.autoclicker"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "caelestia"
CONFIG_FILE = CONFIG_DIR / "autoclicker.conf"
SCRIPT = CONFIG_DIR / "scripts" / "autoclicker.sh"

MIN_CPS = 1
MAX_CPS = 100
DEFAULT_CPS = 20
BUTTONS = ("left", "right")
DEFAULT_BUTTON = "left"
MODES = ("click", "hold")
DEFAULT_MODE = "click"


def read_config():
    cps = DEFAULT_CPS
    button = DEFAULT_BUTTON
    mode = DEFAULT_MODE

    try:
        for line in CONFIG_FILE.read_text().splitlines():
            key, separator, value = line.partition("=")
            if not separator:
                continue

            key = key.strip()
            value = value.strip()

            if key == "cps":
                try:
                    cps = max(MIN_CPS, min(MAX_CPS, int(value)))
                except ValueError:
                    pass
            elif key == "button" and value in BUTTONS:
                button = value
            elif key == "mode" and value in MODES:
                mode = value
    except OSError:
        pass

    return cps, button, mode


def write_config(cps, button, mode):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    temporary = CONFIG_FILE.with_name(CONFIG_FILE.name + ".tmp")
    temporary.write_text(f"cps={cps}\nbutton={button}\nmode={mode}\n")
    temporary.replace(CONFIG_FILE)


def clicker_status():
    try:
        result = subprocess.run(
            [str(SCRIPT), "status"],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return False, None

    parts = result.stdout.strip().split()
    if len(parts) == 3 and parts[0] == "running":
        try:
            return True, int(parts[2])
        except ValueError:
            return True, None
    return False, None


class AutoclickerWindow(Adw.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title="Auto Clicker")
        self.set_default_size(400, 350)
        self.set_resizable(False)

        self._running = False
        self._syncing = False
        self._timer_id = None

        cps, button, mode = read_config()
        self._cps = cps
        self._button = button
        self._mode = mode

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_margin_top(18)
        content.set_margin_bottom(18)
        content.set_margin_start(18)
        content.set_margin_end(18)

        self.status_label = Gtk.Label(label="Stopped", xalign=0)
        self.status_label.add_css_class("dim-label")

        mode_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        mode_title = Gtk.Label(label="Mode", xalign=0)
        mode_title.set_hexpand(True)

        self.mode_drop = Gtk.DropDown.new_from_strings(["Click", "Hold"])
        self.mode_drop.set_selected(MODES.index(mode))
        self.mode_drop.set_valign(Gtk.Align.CENTER)
        self.mode_drop.connect("notify::selected", self.on_mode_changed)

        mode_row.append(mode_title)
        mode_row.append(self.mode_drop)

        speed_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        speed_title = Gtk.Label(label="Click speed", xalign=0)
        speed_title.set_hexpand(True)

        self.spin = Gtk.SpinButton.new_with_range(MIN_CPS, MAX_CPS, 1)
        self.spin.set_digits(0)
        self.spin.set_numeric(True)
        self.spin.set_width_chars(4)
        self.spin.set_valign(Gtk.Align.CENTER)
        self.spin.set_tooltip_text(f"{MIN_CPS}–{MAX_CPS} clicks per second")
        self.spin.set_value(cps)

        cps_label = Gtk.Label(label="CPS", xalign=1)
        cps_label.add_css_class("dim-label")

        speed_row.append(speed_title)
        speed_row.append(self.spin)
        speed_row.append(cps_label)

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, MIN_CPS, MAX_CPS, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.set_value(cps)
        self.scale.connect("value-changed", self.on_scale_changed)
        self.spin.connect("value-changed", self.on_spin_changed)

        self.speed_section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.speed_section.append(speed_row)
        self.speed_section.append(self.scale)
        self.speed_section.set_sensitive(mode != "hold")

        button_choice_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        button_title = Gtk.Label(label="Mouse button", xalign=0)
        button_title.set_hexpand(True)

        self.button_drop = Gtk.DropDown.new_from_strings(["Left", "Right"])
        self.button_drop.set_selected(BUTTONS.index(button))
        self.button_drop.set_valign(Gtk.Align.CENTER)
        self.button_drop.connect("notify::selected", self.on_button_changed)

        button_choice_row.append(button_title)
        button_choice_row.append(self.button_drop)

        button_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        button_row.set_halign(Gtk.Align.END)

        close_button = Gtk.Button(label="Close")
        close_button.connect("clicked", lambda *_: self.close())

        self.toggle_button = Gtk.Button(label="Start")
        self.toggle_button.connect("clicked", self.on_toggle)

        button_row.append(close_button)
        button_row.append(self.toggle_button)

        content.append(self.status_label)
        content.append(mode_row)
        content.append(self.speed_section)
        content.append(button_choice_row)
        content.append(button_row)

        toolbar.set_content(content)
        self.set_content(toolbar)

        key_controller = Gtk.EventControllerKey()
        key_controller.connect("key-pressed", self.on_key_pressed)
        self.add_controller(key_controller)

        self.connect("close-request", self.on_close)

        self.refresh_status()
        self._timer_id = GLib.timeout_add(500, self.refresh_status)

    def save_config(self):
        try:
            write_config(self._cps, self._button, self._mode)
        except OSError as error:
            self.status_label.set_text(f"Could not save settings: {error}")

    def on_mode_changed(self, dropdown, _pspec):
        selected = dropdown.get_selected()
        if selected >= len(MODES):
            return
        self._mode = MODES[selected]
        self.speed_section.set_sensitive(self._mode != "hold")
        self.save_config()
        self.refresh_status()

    def set_speed(self, cps, source):
        cps = max(MIN_CPS, min(MAX_CPS, int(cps)))
        self._cps = cps

        self._syncing = True
        if source != "scale":
            self.scale.set_value(cps)
        if source != "spin":
            self.spin.set_value(cps)
        self._syncing = False

        self.save_config()

    def on_scale_changed(self, scale):
        if not self._syncing:
            self.set_speed(round(scale.get_value()), source="scale")

    def on_spin_changed(self, spin):
        if not self._syncing:
            self.set_speed(spin.get_value(), source="spin")

    def on_button_changed(self, dropdown, _pspec):
        selected = dropdown.get_selected()
        if selected >= len(BUTTONS):
            return
        self._button = BUTTONS[selected]
        self.save_config()

    def on_toggle(self, _button):
        command = "stop" if self._running else "start"
        try:
            result = subprocess.run(
                [str(SCRIPT), command],
                capture_output=True,
                text=True,
                timeout=2,
            )
        except (OSError, subprocess.SubprocessError) as error:
            self.status_label.set_text(f"Could not update clicker: {error}")
            return

        if result.returncode != 0:
            message = result.stderr.strip() or "Autoclicker command failed"
            self.status_label.set_text(message)
            return

        if command == "start":
            self.close()
            return

        self.refresh_status()

    def on_key_pressed(self, _controller, keyval, _keycode, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_close(self, _window):
        if self._timer_id is not None:
            GLib.source_remove(self._timer_id)
            self._timer_id = None
        return False

    def refresh_status(self):
        running, cps = clicker_status()
        self._running = running
        _, button, mode = read_config()

        if running:
            if mode == "hold":
                self.status_label.set_text(f"Holding · {button.title()}")
            else:
                details = f"{cps} CPS · {button.title()}" if cps else button.title()
                self.status_label.set_text(f"Running · {details}")
            self.toggle_button.set_label("Release" if mode == "hold" else "Stop")
            self.toggle_button.remove_css_class("suggested-action")
            self.toggle_button.add_css_class("destructive-action")
        else:
            self.status_label.set_text("Stopped")
            self.toggle_button.set_label("Hold" if mode == "hold" else "Start")
            self.toggle_button.remove_css_class("destructive-action")
            self.toggle_button.add_css_class("suggested-action")

        self.mode_drop.set_sensitive(not running)
        self.button_drop.set_sensitive(not (running and mode == "hold"))

        return True


class AutoclickerApplication(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.DEFAULT_FLAGS,
        )
        self.window = None

    def do_activate(self):
        if self.window is None:
            self.window = AutoclickerWindow(self)
        self.window.present()


if __name__ == "__main__":
    sys.exit(AutoclickerApplication().run(sys.argv))
